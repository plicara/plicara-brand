  "color": {
    "butter": {
      "value": "#F3DC7C",
      "comment": "The one hot colour. A fill, never an ink. The glyph fill and the accent of both dark schemes."
    },
    "sumi": {
      "value": "#2B2422",
      "comment": "Warm near-black, like ink that has dried. Primary text on light; the outline colour of every drawing."
    },
    "washi": {
      "value": "#FAF6ED",
      "comment": "Warm paper white. Light ground; primary text on dark."
    },
    "white": {
      "value": "#FFFFFF",
      "comment": "Surfaces on the light ground."
    },
    "cream": {
      "value": "#F7EBC9",
      "comment": "Raised warm surface on the light grounds. Tiles, table rows, code blocks."
    },
    "night": {
      "value": "#1F292E",
      "comment": "Green-cast charcoal, a garden at dusk. Primary dark ground."
    },
    "slate": {
      "value": "#2C3A40",
      "comment": "Raised surface on night."
    },
    "jade": {
      "value": "#1B6055",
      "comment": "Deep leaf teal. Panel ground on dark pages; can ink on washi."
    },
    "plum": {
      "value": "#4E2338",
      "comment": "Deep wine. Panel ground on dark pages."
    },
    "teal": {
      "value": "#3EB7C6",
      "comment": "First chart series on the dark grounds."
    },
    "blossom": {
      "value": "#F0A7C0",
      "comment": "Soft pink. Second chart series on night; recessive detail."
    },
    "magenta": {
      "value": "#B92D77",
      "comment": "Deep pink. Accent ink on the warm light ground; on dark grounds a fill, never an ink."
    },
    "royal": {
      "value": "#2F3BB3",
      "comment": "Saturated blue. Accent ink and first series on the light grounds."
    },
    "mint": {
      "value": "#63C6A0",
      "comment": "Green. Second chart series on the blueprint ground."
    },
    "lilac": {
      "value": "#C9A9E2",
      "comment": "Pale violet. Recessive detail on dark grounds."
    },
    "brick": {
      "value": "#A8333A",
      "comment": "Warm red. Second chart series on the light grounds."
    },
    "print": {
      "value": "#1B2E63",
      "comment": "Blueprint blue. Dark ground for benchmarks and tools."
    },
    "drafting": {
      "value": "#24397A",
      "comment": "Raised surface on print."
    }
